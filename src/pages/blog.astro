---
import Layout from "../layouts/Layout.astro";
import { markdown } from "@astropub/md";
import { DateTime } from "luxon";
import { getBlogPosts } from "../util/blog";
const posts = await getBlogPosts();
---

<Layout title="OpenLab Augsburg e.V. - Blog">
  <div class="container mx-auto">
    <div class="grid lg:grid-cols-2 md:grid-cols-2 grid-cols-1 gap-8 px-10">
      {
        posts.map((post) => (
          <a class="no-underline hover:underline" href={post.externalUrl}>
            <div class="card card-border">
              <div class="flex flex-col">
                {post.banner && (
                  <img
                    class="m-0 max-h-[250px] w-full rounded-xl object-cover p-0"
                    src={post.banner}
                  />
                )}
                <div class="card-body">
                  <h3 class="card-title truncate text-xl text-ellipsis">
                    {post.title}
                  </h3>
                  <h5 class="truncate text-lg">{post.subtitle}</h5>
                </div>
              </div>
            </div>
          </a>
        ))
      }
      {
        posts.length == 0 && (
          <h3 class="mx-auto">Aktuell noch keine Blogposts vorhanden</h3>
        )
      }
    </div>
  </div>
</Layout>
