---
import Layout from "../../layouts/Layout.astro";

import directusClient from "../../util/directus";
import { readItem, readItems } from "@directus/sdk";
import { DIRECTUS_URL } from "astro:env/server";
import { Icon } from "astro-icon/components";
import { DateTime } from "luxon";
import { linear } from "svelte/easing";
import { markdown } from "@astropub/md";

export const getStaticPaths = async () => {
  return await directusClient
    .request(
      readItems("Calendar", {
        filter: {
          status: { _eq: "published" },
        },
      }),
    )
    .then((events) => {
      return events.map((event) => {
        return {
          params: { eventId: event.id },
        };
      });
    });
};

const { eventId } = Astro.params;

const event = await directusClient.request(readItem("Calendar", eventId));

function renderDate(iso: string, locale: string) {
  return DateTime.fromISO(iso)
    .setLocale(locale)
    .toLocaleString(DateTime.DATETIME_FULL);
}
---

<Layout title="OpenLab Augsburg e.V. - Event">
  <div class="m-auto mb-10 w-11/12 max-w-prose">
    <img
      src={`${DIRECTUS_URL}/assets/${event.image}`}
      class="max-h-[250px] w-full rounded-xl object-cover"
    />

    <h1>{event.title}</h1>

    <div class="card bg-base-200 card-lg shadow-sm">
      <div
        class="card-body m-auto grid w-3/4 grid-cols-[1fr_2fr_3fr] content-center items-start"
      >
        <Icon name="mdi:calendar" size={30} />
        <strong class="">Beginn</strong>
        <div>{renderDate(event.starts_at, "de")}</div>
        {
          event.ends_at && (
            <>
              <div />
              <strong>Ende</strong>
              <div>{renderDate(event.ends_at, "de")}</div>
            </>
          )
        }
        <Icon name="mdi:map-marker" size={30} />
        <strong>Ort</strong>
        <div>
          {event.location.split("\n").map((line) => <div>{line}</div>)}
        </div>
        <Icon name="mdi:earth" size={30} />
        <strong>Öffentlich</strong>
        <div>{event.public ? "Ja" : "Nein"}</div>
      </div>
    </div>

    <div set:html={await markdown(event.description)} />

    {
      event.url && (
        <a href={event.url} class="btn btn-primary not-prose w-full">
          Mehr Infos
        </a>
      )
    }
  </div>
</Layout>
