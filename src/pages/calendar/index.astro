---
import { readItems } from "@directus/sdk";

  import moment from 'moment';
import { DIRECTUS_URL } from "astro:env/server";

import Layout from "../../layouts/Layout.astro";
import FullCalendar  from "./fullcalendar.vue";
import { markdown } from "@astropub/md";

import { DateTime } from "luxon";
import { getCalendarEvents } from "../../util/directus";

const events = await getCalendarEvents();

---

<Layout>
  <div class="m-auto my-10 w-11/12">
    <h1>Kalender</h1>
    <div class="m-auto w-11/12">
      <FullCalendar events={events} client:load="vue" />
    </div>
    <h1 class="mt-20">Events</h1>
    <div class="m-auto my-10">
        <div
          class="grid grid-cols-1 gap-4 backdrop-blur-md sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            await Promise.all(
              events.map(async (event) => (
                <div
                  class:list={[
                    "card",
                    "bg-base-200",
                    "not-prose",
                    "w-full",
                    "shadow-xl",
                  ]}
                >
                  {/* {event.image && (
                    <div class="card-image">
                      <figure>
                        <img
                          src={`${DIRECTUS_URL}/assets/${event.image}`}
                          alt="flavor pic"
                        />
                      </figure>
                    </div>
                  )}
    */}
                  <div class="card-body">
                      <div class="flex justify-between">
                                      <h2 class="card-title">{event.title}</h2>
                    <div class="badge badge-soft pt-2" class:list={[{'badge-success': event.public}]}>{event.public ? "Öffentlich" : "Nur Mitglieder"}</div>
                  </div>
                    <div>
                    <p>
                      {DateTime.fromISO(event.starts_at)
                        .setLocale("de")
                        .toRelative()}
                    </p>
                    </div>
                    <p>
                      {moment(event.starts_at).format("DD.MM.YYYY HH:MM")}
                    </p>
                    {/* <p set:html={await markdown(event.description)} /> */}
                    <div>
                      <div class="card-actions justify-start">
                      </div>
                      <div class="card-actions justify-end">
                        <a href={`/events/${event.id}`} class="btn btn-primary">
                          Mehr Infos
                        </a>
                      </div>
                      </div>
                  </div>
                </div>
              )),
            )
          }
          </div>
      </div>
  </div>
</Layout>