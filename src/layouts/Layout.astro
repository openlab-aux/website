---
import "../styles/global.css";

export interface Props {
  title?: string;
}

import { Icon } from "astro-icon/components";

const BASE_TITLE = "OpenLab Augsburg";

let { title } = Astro.props;

title = title ? `${title} | ${BASE_TITLE}` : BASE_TITLE;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <nav
      class="navbar bg-base-100/50 sticky top-0 z-50 w-screen shadow-xl backdrop-blur-sm"
    >
      <div class="flex-1">
        <a class="btn btn-ghost text-xl" href="/"
          >OpenLab <span class="max-sm:hidden">Augsburg</span></a
        >
      </div>
      <div class="flex-none px-3">
        <ul class="menu menu-horizontal">
          <li><a class="btn btn-ghost" href="/wo">Wo?!</a></li>
          <li><a class="btn btn-ghost" href="/calendar">Kalender</a></li>
          <li><a class="btn btn-ghost" href="/satzung">Satzung</a></li>
          <li>
            <details>
              <summary class="btn btn-ghost">Tools</summary>
              <ul class="bg-base-100 rounded-t-none p-2 z-50 w-fit sticky right-2.5">
                <li>
                  <a class="btn btn-ghost text-right">
                    Chat
                    <Icon name="mdi:link-variant" size={20} />
                  </a>
                </li>
                <li>
                  <a class="btn btn-ghost text-right">
                    Wiki
                    <Icon name="mdi:link-variant" size={20} />
                  </a>
                </li>
                <li>
                  <a class="btn btn-ghost text-right">
                    Cryptpad
                    <Icon name="mdi:link-variant" size={20} />
                  </a>
                </li>
              </ul>
            </details>
          </li>
        </ul>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  a {
    text-decoration: none;
  }
</style>
